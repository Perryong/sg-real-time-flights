{
  "$defs": {
    "FeedStatus": {
      "properties": {
        "movements": {
          "anyOf": [
            {
              "$ref": "#/$defs/MovementSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "default": "live",
          "enum": [
            "live",
            "simulated",
            "recorded"
          ],
          "title": "Mode",
          "type": "string"
        },
        "upstream_state": {
          "default": "unavailable",
          "title": "Upstream State",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "configuration_required",
          "title": "Error Code"
        },
        "message": {
          "default": "ADSB.fi live polling is disabled. Enable live mode for personal, non-commercial use in the backend configuration.",
          "title": "Message",
          "type": "string"
        },
        "last_attempt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Attempt"
        },
        "last_success": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Success"
        },
        "next_retry": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Retry"
        },
        "newest_position_time": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Newest Position Time"
        },
        "geometry_edition": {
          "default": "Open geometry \u00b7 19 NOV 2026 (provisional)",
          "title": "Geometry Edition",
          "type": "string"
        },
        "counters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "title": "Counters",
          "type": "object"
        },
        "sources": {
          "additionalProperties": {
            "$ref": "#/$defs/SourceStatus"
          },
          "title": "Sources",
          "type": "object"
        }
      },
      "title": "FeedStatus",
      "type": "object"
    },
    "HistoricalRoute": {
      "properties": {
        "provider": {
          "const": "flyitalyadsb",
          "default": "flyitalyadsb",
          "title": "Provider",
          "type": "string"
        },
        "callsign": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Callsign",
          "type": "string"
        },
        "origin": {
          "pattern": "^[A-Z]{4}$",
          "title": "Origin",
          "type": "string"
        },
        "destination": {
          "pattern": "^[A-Z]{4}$",
          "title": "Destination",
          "type": "string"
        },
        "origin_iata": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Iata"
        },
        "destination_iata": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Iata"
        },
        "observed_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Observed Count",
          "type": "integer"
        },
        "last_seen_day": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Last Seen Day",
          "type": "string"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "number"
        }
      },
      "required": [
        "callsign",
        "origin",
        "destination",
        "observed_count",
        "last_seen_day",
        "retrieved_at"
      ],
      "title": "HistoricalRoute",
      "type": "object"
    },
    "MovementSummary": {
      "properties": {
        "day": {
          "title": "Day",
          "type": "string"
        },
        "airport": {
          "const": "WSSS",
          "default": "WSSS",
          "title": "Airport",
          "type": "string"
        },
        "timezone": {
          "const": "Asia/Singapore",
          "default": "Asia/Singapore",
          "title": "Timezone",
          "type": "string"
        },
        "available": {
          "default": true,
          "title": "Available",
          "type": "boolean"
        },
        "landings": {
          "default": 0,
          "title": "Landings",
          "type": "integer"
        },
        "takeoffs": {
          "default": 0,
          "title": "Takeoffs",
          "type": "integer"
        },
        "first_observed_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Observed At"
        },
        "last_observed_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Observed At"
        },
        "observed_seconds": {
          "default": 0,
          "title": "Observed Seconds",
          "type": "number"
        },
        "unmonitored_seconds": {
          "default": 0,
          "title": "Unmonitored Seconds",
          "type": "number"
        }
      },
      "required": [
        "day"
      ],
      "title": "MovementSummary",
      "type": "object"
    },
    "Observation": {
      "properties": {
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoricalRoute"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "live",
            "simulated",
            "recorded"
          ],
          "title": "Mode",
          "type": "string"
        },
        "callsign": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callsign"
        },
        "registration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registration"
        },
        "aircraft_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aircraft Type"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "alt_geom_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt Geom M"
        },
        "alt_baro_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt Baro M"
        },
        "ground": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ground"
        },
        "speed_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Mps"
        },
        "track_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Deg"
        },
        "heading_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Deg"
        },
        "vertical_rate_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vertical Rate Mps"
        },
        "position_time": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Time"
        },
        "provider_time": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Time"
        },
        "message_time": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Time"
        },
        "receipt_time": {
          "title": "Receipt Time",
          "type": "number"
        },
        "timestamp_quality": {
          "default": "unknown",
          "enum": [
            "derived",
            "unknown"
          ],
          "title": "Timestamp Quality",
          "type": "string"
        },
        "source_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Category"
        },
        "quality": {
          "additionalProperties": true,
          "title": "Quality",
          "type": "object"
        },
        "raw": {
          "additionalProperties": true,
          "title": "Raw",
          "type": "object"
        }
      },
      "required": [
        "id",
        "provider",
        "provider_id",
        "session_id",
        "mode",
        "lat",
        "lon",
        "receipt_time"
      ],
      "title": "Observation",
      "type": "object"
    },
    "PhaseEstimate": {
      "properties": {
        "phase": {
          "default": "unknown",
          "title": "Phase",
          "type": "string"
        },
        "candidate_runways": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Runways",
          "type": "array"
        },
        "confidence": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "evidence_times": {
          "items": {
            "type": "number"
          },
          "title": "Evidence Times",
          "type": "array"
        },
        "rule_version": {
          "default": "1.0",
          "title": "Rule Version",
          "type": "string"
        }
      },
      "title": "PhaseEstimate",
      "type": "object"
    },
    "SourceStatus": {
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "last_attempt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Attempt"
        },
        "last_success": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Success"
        },
        "next_retry": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Retry"
        },
        "requests": {
          "default": 0,
          "title": "Requests",
          "type": "integer"
        },
        "remaining_credits": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remaining Credits"
        }
      },
      "required": [
        "enabled",
        "state"
      ],
      "title": "SourceStatus",
      "type": "object"
    },
    "Track": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "latest": {
          "$ref": "#/$defs/Observation"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "History",
          "type": "array"
        },
        "phase": {
          "$ref": "#/$defs/PhaseEstimate"
        }
      },
      "required": [
        "id",
        "session_id",
        "latest",
        "history"
      ],
      "title": "Track",
      "type": "object"
    }
  },
  "properties": {
    "type": {
      "const": "snapshot",
      "default": "snapshot",
      "title": "Type",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "epoch": {
      "title": "Epoch",
      "type": "string"
    },
    "sequence": {
      "title": "Sequence",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "live",
        "simulated",
        "recorded"
      ],
      "title": "Mode",
      "type": "string"
    },
    "server_time": {
      "title": "Server Time",
      "type": "number"
    },
    "scenario_time": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Time"
    },
    "status": {
      "$ref": "#/$defs/FeedStatus"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/Track"
      },
      "title": "Tracks",
      "type": "array"
    }
  },
  "required": [
    "epoch",
    "sequence",
    "mode",
    "server_time",
    "status",
    "tracks"
  ],
  "title": "Snapshot",
  "type": "object"
}

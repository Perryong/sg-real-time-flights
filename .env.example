# ADSB.fi public API: personal, non-commercial use only. https://github.com/adsbfi/opendata
# Set both flags true for your personal local tracker. No account or API key required.
LIVE_ENABLED=false
ADSBFI_PERSONAL_USE=false
POLL_SECONDS=10
# Optional Changi ground supplement. Keep off until OpenSky live-use permission is clarified.
# Credentials stay server-side; never prefix them with VITE_. Polling is at most once per 30 seconds.
OPENSKY_ENABLED=false
OPENSKY_USE_CONFIRMED=false
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Optional free regional supplement. API key stays on the backend; checks every 30 seconds.
FLYITALYADSB_ENABLED=false
FLYITALYADSB_API_KEY=
ALLOWED_ORIGINS=http://localhost:5177,http://127.0.0.1:5177,http://localhost:4177,http://127.0.0.1:4177
